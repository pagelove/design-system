{
  "id": "editorial",
  "name": "Editorial",
  "description": "Warm paper, slate ink and restrained lavender; a quieter reading-focused design.",
  "defaultMode": "light",
  "modes": {
    "light": {
      "link-text-default": "var(--color-cornflower-blue-700)",
      "border-strong": "var(--color-polo-blue-500)",
      "border-focused": "var(--color-cornflower-blue-600)"
    },
    "dark": {
      "border-strong": "var(--color-polo-blue-500)",
      "border-focused": "var(--color-cornflower-blue-400)"
    }
  },
  "foundations": {
    "color": {
      "polo-blue": {
        "0": "#faf7f1",
        "50": "#f3efe7",
        "100": "#eae5dc",
        "200": "#ddd7cc",
        "300": "#c9c3b7",
        "400": "#a59f95",
        "500": "#716c65",
        "600": "#45556c",
        "700": "#303e52",
        "800": "#243145",
        "900": "#1a2435",
        "950": "#121b2a",
        "1000": "#0c1420"
      }
    }
  },
  "appearance": {
    "design-radius-card": "4px",
    "design-radius-button": "6px",
    "design-heading-family": "var(--font-family-brand)",
    "design-body-family": "var(--font-family-secondary)",
    "design-content-width": "1040px",
    "design-section-gap": "32px",
    "design-shadow-panel": "none",
    "design-page-padding": "48px",
    "design-panel-padding": "32px",
    "design-row-padding": "24px",
    "design-radius-input": "4px",
    "design-title-size": "3rem",
    "design-heading-tracking": "-.03em",
    "design-transition-duration": "160ms",
    "design-text-small": "0.875rem",
    "design-text-caption": "0.75rem",
    "design-title-size-mobile": "2.25rem",
    "design-press-offset": "1px"
  },
  "guidance": "Use warm paper surfaces, slate ink, square-edged reading panels and understated actions. Prefer long-form content and clear type hierarchy. Use the bundled local fonts and product compositions. Separate page, panel and inset surfaces; keep metadata quiet but readable. Use the exported page/panel/row spacing and title scale consistently, with 44px action targets and brief 160ms interaction feedback. See docs/polish.md for the complete product contract."
}
