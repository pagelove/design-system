  "appearance": {
    "design-radius-card": "8px",
    "design-radius-button": "8px",
    "design-heading-family": "var(--font-family-secondary)",
    "design-body-family": "var(--font-family-secondary)",
    "design-content-width": "1200px",
    "design-section-gap": "20px",
    "design-shadow-panel": "none",
    "design-page-padding": "40px",
    "design-panel-padding": "24px",
    "design-row-padding": "18px",
    "design-radius-input": "6px",
    "design-title-size": "2.75rem",
    "design-heading-tracking": "-.04em",
    "design-transition-duration": "160ms"
  },
  "guidance": "Start in dark mode. Use deep plum surfaces, pale lavender interaction accents, sans-serif headings and compact geometry. This design has no light mode; do not generate one by inversion. Use the bundled local fonts and product compositions. Separate page, panel and inset surfaces; keep metadata quiet but readable. Use the exported page/panel/row spacing and title scale consistently, with 44px action targets and brief 160ms interaction feedback. See docs/polish.md for the complete product contract."
}
