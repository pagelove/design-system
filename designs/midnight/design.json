{
  "id": "midnight",
  "name": "Midnight",
  "description": "A dark-only plum workspace, lavender links and compact geometric controls.",
  "defaultMode": "dark",
  "modes": {
    "dark": {}
  },
  "foundations": {
    "color": {
      "polo-blue": {
        "0": "#f3efff",
        "50": "#e8e2f7",
